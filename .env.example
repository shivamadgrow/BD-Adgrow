# ==============================================================================
# Ad Grow BD — Global Business Intelligence & Opportunity Finder
# Environment Variable Configuration Template
# ==============================================================================

# Application Base
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Ad Grow BD"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://adgrow_user:secure_password@localhost:5432/adgrow_bd?schema=public"

# Redis Cache & Background Tasks
REDIS_URL="redis://localhost:6379"

# Google Maps Platform / Places API (New)
# Required for live worldwide POI discovery beyond verified local registry
# https://console.cloud.google.com/google/maps-apis/
GOOGLE_PLACES_API_KEY=""

# Google PageSpeed Insights API
# Required for real-time live Core Web Vitals and Lighthouse audits
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_INSIGHTS_API_KEY=""

# AI Provider Configuration (Optional for customized model prompts)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CRM & Email Delivery (Optional for automated outbound dispatch)
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
